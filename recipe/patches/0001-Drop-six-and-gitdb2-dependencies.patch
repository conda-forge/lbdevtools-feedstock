@@ -83,7 +82,7 @@ def get_active_lines(filename):
 
 if __name__ == "__main__":
     with open("CMakeLists.txt", "rb") as fh:
-        data = cPickle.load(COVERAGE_FILE)
+        data = pickle.load(COVERAGE_FILE)
     lines = data["lines"]
     for filename in sorted(lines):
         if not os.path.exists(filename):
diff --git a/pyproject.toml b/pyproject.toml
index 53301e8..c8b8464 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -23,10 +23,8 @@ dependencies = [
     "jinja2",
     "yapf==0.24.0",
     "whichcraft",
-    "six",
     "GitPython>=2.1.12",
     "python-gitlab>=2",
-    "gitdb2>=3",
 ]
